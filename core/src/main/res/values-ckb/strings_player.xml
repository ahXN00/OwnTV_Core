    <string name="player_smoothness_hint">ئەم کەناڵە هەندێک فرەیم لەدەست دەدات. گۆڕینی پەخشکەر بۆ MPV لەوانەیە پەخشەکە ڕەوانتر بکات.</string>
    <string name="player_error_image_subtitle_audio">ژێرنووسی وێنەیی بەردەست نییە\' بۆ فۆرماتی دەنگی ئەم ڤیدیۆیە\'.</string>
    <string name="player_error_both_engines_exo_first">پەخش لە هەردوو بزوێنەری ڤیدیۆدا شکستی هێنا (ExoPlayer, پاشان mpv). لەوانەیە فایلەکە تێکچووبێت یان فۆرماتێکی هەبێت کە ئەم تەلەڤیزیۆنە ناتوانێت\' پەخشی بکات.</string>
    <string name="player_error_both_engines_mpv_first">پەخش لە هەردوو بزوێنەری ڤیدیۆدا شکستی هێنا (mpv و ExoPlayer). لەوانەیە فایلەکە تێکچووبێت یان فۆرماتێکی هەبێت کە ئەم تەلەڤیزیۆنە ناتوانێت\' پەخشی بکات. (<xliff:g id="error">%1$s</xliff:g>)</string>
    <string name="player_error_stream_link">نەتوانرا بەستەری پەخش لە پۆرتاڵەکە وەربگیرێت. پەیوەندییەکە بپشکنە و دووبارە هەوڵ بدەوە.</string>
    <string name="player_error_not_streaming">ئەم ڤیدیۆیە ئامادە نەکراوە\' بۆ پەخشی ڕاستەوخۆ. داوا لە دابینکەر بکە دووبارە- کۆدی بکاتەوە بە دەستپێکی- خێرا, یان سەرەتا دایبگرە.</string>
    <string name="player_error_lost_connection">پەیوەندی بە ئەم کەناڵەوە پچڕا.</string>
    <string name="player_error_channel">نەتوانرا\' ئەم کەناڵە پەخش بکرێت.</string>
    <string name="player_error_exo_decode">ExoPlayer ناتوانێت\' فۆرماتی ئەم ڤیدیۆیە\' لەسەر ئەم ئامێرە کۆد بکاتەوە (<xliff:g id="error">%1$s</xliff:g>).</string>
    <string name="player_error_exo_play">ExoPlayer نەتوانی\' ئەم پەخشە بکات (<xliff:g id="error">%1$s</xliff:g>).</string>
    <string name="player_error_image_format">ژێرنووسی وێنەیی بەردەست نییە\' بۆ فۆرماتی ئەم فایلە\'.</string>
    <string name="player_error_image_show">نەتوانرا\' ژێرنووسی وێنەیی بۆ ئەم فایلە پیشان بدرێت.</string>
    <string name="player_external_could_not_open">نەتوانرا ئەم پەخشە بکرێتەوە.</string>
    <string name="player_external_not_found">هیچ پەخشکەرێکی دەرەکی نەدۆزرایەوە — VLC یان MX Player دابمەزرێنە.</string>
    <string name="player_error_audio_no_video">دەنگ پەخش دەکرێت, بەڵام نەتوانرا ڤیدیۆ لەسەر ئەم ئامێرە پیشان بدرێت.</string>
    <string name="player_error_file_corrupt">فایلی ئەم ڤیدیۆیە\' پێکهاتەکەی هەڵەیە یان تێکچووە و ناتوانرێت\' پەخش بکرێت.</string>
    <string name="player_error_multiple_videos">پەخشکردنی چەند ڤیدیۆیەک شکستی هێنا. لەوانەیە سەرچاوەکە بەردەست نەبێت یان فایلەکان تێکچووبن.</string>
    <string name="player_error_decoder_busy">کۆدکەرەوەی ڤیدیۆی ئەم تەلەڤیزیۆنە\' سەرقاڵە. کەمێکی تر دووبارە هەوڵ بدەوە.</string>
    <string name="player_error_no_internet">پەیوەندی ئینتەرنێت نییە. تۆڕەکەت بپشکنە و دووبارە هەوڵ بدەوە.</string>
    <string name="player_error_stream_unavailable">نەتوانرا\' ئەم پەخشە بکرێت. لەوانەیە سەرچاوەکە ئۆفلاین بێت یان فۆرماتەکەی پشتگیری نەکرێت. <xliff:g id="hint">%1$s</xliff:g></string>
    <string name="player_error_account_in_use">ئەم هەژمارە ئێستا لە ئامێرێک یان ئەپێکی تردا پەخش دەکات. لەوێ پەخشەکە بوەستێنە, پاشان دووبارە هەوڵدانەوە دابگرە.</string>
    <string name="player_error_mpv_open_decode">mpv نەتوانی\' ئەم فایلە بکاتەوە یان کۆدی بکاتەوە.</string>
    <string name="player_error_mpv_stream_never_started">دوای چەند هەوڵدانەوەیەکیش پەخشەکە لە mpv دەستی پێ نەکرد.</string>
    <string name="player_error_fairplay">ئەم پەخشە بە Apple FairPlay پارێزراوە, کە ئامێرەکانی Android ناتوانن\' پەخشی بکەن. لیستی پەخشەکە بۆ ئامێرەکانی Apple دروست کراوە.</string>
    <string name="player_error_surround">ئەم دەرچوونەی دەنگ ناتوانێت\' دەنگی دەوروبەر پەخش بکات — گۆڕدرا بۆ ستێریۆ.</string>
    <string name="player_error_hardware_fallback">فۆرماتی ئەم پەخشە\' نەتوانرا\' بە ڕەقەکاڵا- لەسەر ئەم تەلەڤیزیۆنە کۆد بکرێتەوە, بۆیە گەڕایەوە بۆ کۆدکردنەوەی نەرمەکاڵایی — کە ناتوانێت\' بەردەوام بێت لە پەخشی <xliff:g id="resolution">%1$s</xliff:g> بەبێ بارگرانی لەسەر تەلەڤیزیۆنەکە. لەوانەیە تەلەڤیزیۆنەکە هێشتا ناوەڕۆکی تری 4K بەباشی پەخش بکات; کێشەکە فۆرماتی ئەم پەخشەیە\'.</string>
    <string name="player_error_hardware_disabled">کۆدکردنەوەی ڕەقەکاڵایی ناچالاکە — کۆدکردنەوەی نەرمەکاڵایی ناتوانێت\' ڤیدیۆی <xliff:g id="resolution">%1$s</xliff:g> پەخش بکات. چالاکی بکە لە ڕێکخستنەکان → پەخشکەری ڤیدیۆ.</string>
    <string name="player_error_custom_user_agent">لەوانەیە ئەم دابینکەرە پێویستی بە User-Agentی تایبەت هەبێت لە ڕێکخستنەکانی سەرچاوەدا.</string>
    <string name="player_reason_decoder_busy">کۆدکەرەوەی ڕەقەکاڵایی ڤیدیۆ سەرقاڵە یان ناتوانێت\' ئەم پەخشە بکات</string>
    <string name="player_reason_decoder_transient">هەڵەی دیکۆدەری ڤیدیۆی ڕەقەواڵە — کاتییە, دووبارە هەوڵ بدە</string>
    <string name="player_reason_unsupported_video">دیکۆدەری ئەم ئامێرە\' پشتگیری ناکات\' لەم فۆرماتەی ڤیدیۆ/پرۆفایلە (بۆ.نموونە. HEVC 10-بیت)</string>
    <string name="player_reason_decoder_memory">بیرگەی ئامێر بۆ دیکۆدەر تەواو بوو — هەوڵ بدە ئەپەکانی تر دابخەیت</string>
    <string name="player_reason_drm">DRM / هەڵەی دیکۆدەری-پارێزراو</string>
    <string name="player_reason_http_509">دابینکەر پەیوەندییەکەی بلۆک کرد — ژمارەیەکی زۆر پەخش لە یەک کاتدا (HTTP 509)</string>
    <string name="player_reason_http_403">دابینکەر ڕێگەی دەستگەیشتنی نەدا (HTTP 403) — زانیاریی چوونەژوورەوە, بەشداری, یان بلۆککردنی IP</string>
    <string name="player_reason_http_401">دابینکەر چوونەژوورەوەکەتی ڕەت کردەوە (HTTP 401)</string>
    <string name="player_reason_http_404">پەخشەکە لای دابینکەر نەدۆزرایەوە (HTTP 404)</string>
