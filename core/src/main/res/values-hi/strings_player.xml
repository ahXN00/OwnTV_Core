    <string name="player_error_image_subtitle_audio">इस वीडियो के ऑडियो फ़ॉर्मैट के लिए चित्र-आधारित सबटाइटल उपलब्ध नहीं हैं।</string>
    <string name="player_error_both_engines_exo_first">दोनों वीडियो इंजन पर प्लेबैक विफल रहा (पहले ExoPlayer, फिर mpv)। फ़ाइल खराब हो सकती है या ऐसे फ़ॉर्मैट में हो सकती है जिसे यह टीवी नहीं चला सकता।</string>
    <string name="player_error_both_engines_mpv_first">दोनों वीडियो इंजन पर प्लेबैक विफल रहा (mpv और ExoPlayer)। फ़ाइल खराब हो सकती है या ऐसे फ़ॉर्मैट में हो सकती है जिसे यह टीवी नहीं चला सकता। (<xliff:g id="error">%1$s</xliff:g>)</string>
    <string name="player_error_stream_link">पोर्टल से स्ट्रीम लिंक नहीं मिल सका। कनेक्शन जाँचें और फिर से कोशिश करें।</string>
    <string name="player_error_not_streaming">यह वीडियो स्ट्रीमिंग के लिए सही तरीके से फ़ॉर्मैट नहीं किया गया है। प्रदाता से इसे फ़ास्ट-स्टार्ट के साथ फिर से एन्कोड करने के लिए कहें या पहले इसे डाउनलोड करें।</string>
    <string name="player_error_lost_connection">इस चैनल से कनेक्शन टूट गया।</string>
    <string name="player_error_channel">यह चैनल नहीं चलाया जा सका।</string>
    <string name="player_error_exo_decode">ExoPlayer इस डिवाइस पर इस वीडियो के फ़ॉर्मैट को डिकोड नहीं कर सकता (<xliff:g id="error">%1$s</xliff:g>)।</string>
    <string name="player_error_exo_play">ExoPlayer इस स्ट्रीम को नहीं चला सका (<xliff:g id="error">%1$s</xliff:g>)।</string>
    <string name="player_error_image_format">इस फ़ाइल के फ़ॉर्मैट के लिए चित्र-आधारित सबटाइटल उपलब्ध नहीं हैं।</string>
    <string name="player_error_image_show">इस फ़ाइल के चित्र-आधारित सबटाइटल नहीं दिखाए जा सके।</string>
    <string name="player_external_could_not_open">यह स्ट्रीम नहीं खोली जा सकी।</string>
    <string name="player_external_play_with">इससे चलाएँ</string>
    <string name="player_external_play_with_item">“<xliff:g id="channel">%1$s</xliff:g> · <xliff:g id="programme">%2$s</xliff:g>” को इससे चलाएँ…</string>
    <string name="player_external_not_found">कोई बाहरी प्लेयर नहीं मिला — VLC या MX प्लेयर इंस्टॉल करें।</string>
    <string name="player_error_audio_no_video">ऑडियो चल रहा है, लेकिन इस डिवाइस पर वीडियो रेंडर नहीं किया जा सका।</string>
    <string name="player_error_file_corrupt">इस वीडियो की फ़ाइल विकृत या खराब है और इसे चलाया नहीं जा सकता।</string>
    <string name="player_error_multiple_videos">एक से अधिक वीडियो नहीं चल सके। स्रोत अनुपलब्ध हो सकता है या फ़ाइलें खराब हो सकती हैं।</string>
    <string name="player_error_decoder_busy">इस टीवी का वीडियो डिकोडर व्यस्त है। कुछ देर बाद फिर से कोशिश करें।</string>
    <string name="player_error_no_internet">इंटरनेट कनेक्शन नहीं है। अपना नेटवर्क जाँचें और फिर से कोशिश करें।</string>
    <string name="player_error_stream_unavailable">यह स्ट्रीम नहीं चलाई जा सकी। स्रोत ऑफ़लाइन हो सकता है या असमर्थित फ़ॉर्मैट का उपयोग कर सकता है। <xliff:g id="hint">%1$s</xliff:g></string>
    <string name="player_error_mpv_open_decode">mpv इस फ़ाइल को खोल या डिकोड नहीं सका।</string>
    <string name="player_error_mpv_stream_never_started">कई बार कोशिश करने के बाद भी स्ट्रीम mpv में शुरू नहीं हुई।</string>
    <string name="player_error_surround">यह ऑडियो आउटपुट सराउंड ध्वनि नहीं चला सकता — स्टीरियो पर स्विच किया गया।</string>
    <string name="player_error_hardware_fallback">इस स्ट्रीम के फ़ॉर्मैट को इस टीवी पर हार्डवेयर से डिकोड नहीं किया जा सका, इसलिए सॉफ़्टवेयर डिकोडिंग का उपयोग किया गया — जो टीवी पर अधिक भार डाले बिना <xliff:g id="resolution">%1$s</xliff:g> को लगातार नहीं चला सकती। टीवी अन्य 4K सामग्री ठीक से चला सकता है; समस्या इस विशेष स्ट्रीम के फ़ॉर्मैट में है।</string>
    <string name="player_error_hardware_disabled">हार्डवेयर डिकोडिंग बंद है — सॉफ़्टवेयर डिकोडिंग <xliff:g id="resolution">%1$s</xliff:g> वीडियो को नहीं संभाल सकती। इसे सेटिंग → वीडियो प्लेयर में चालू करें।</string>
    <string name="player_error_custom_user_agent">इस प्रदाता के लिए स्रोत सेटिंग में कस्टम User-Agent की आवश्यकता हो सकती है।</string>
    <string name="player_reason_decoder_busy">हार्डवेयर वीडियो डिकोडर व्यस्त है या इस स्ट्रीम को संभाल नहीं सकता</string>
    <string name="player_reason_decoder_transient">हार्डवेयर वीडियो डिकोडर त्रुटि — अस्थायी है, फिर से कोशिश करें</string>
    <string name="player_reason_unsupported_video">इस डिवाइस का डिकोडर इस वीडियो फ़ॉर्मैट/प्रोफ़ाइल का समर्थन नहीं करता (जैसे HEVC 10-bit)</string>
    <string name="player_reason_decoder_memory">डिकोडर के लिए डिवाइस की मेमोरी समाप्त हो गई — अन्य ऐप बंद करके देखें</string>
    <string name="player_reason_drm">DRM / सुरक्षित डिकोडर त्रुटि</string>
    <string name="player_reason_http_509">प्रदाता ने कनेक्शन ब्लॉक कर दिया — एक साथ बहुत अधिक स्ट्रीम चल रही हैं (HTTP 509)</string>
    <string name="player_reason_http_403">प्रदाता ने पहुँच अस्वीकार कर दी (HTTP 403) — क्रेडेंशियल, सदस्यता या IP ब्लॉक की समस्या</string>
    <string name="player_reason_http_401">प्रदाता ने आपका लॉगिन अस्वीकार कर दिया (HTTP 401)</string>
    <string name="player_reason_http_404">प्रदाता पर स्ट्रीम नहीं मिली (HTTP 404)</string>
    <string name="player_reason_http_400">प्रदाता ने अनुरोध अस्वीकार कर दिया (HTTP 400) — लिंक गलत है या उसकी समय-सीमा समाप्त हो गई है</string>
    <string name="player_reason_ssl">प्रदाता का SSL प्रमाणपत्र अमान्य है या उसकी समय-सीमा समाप्त हो गई है</string>
    <string name="player_reason_format">स्ट्रीम फ़ॉर्मैट पहचाना नहीं गया (स्ट्रीम गलत या अधूरी है)</string>
